# ==============================================================================
# LRCGlass Environment Configuration
# ==============================================================================

# Spotify Web API Credentials (Server-side only)
# Used for primary music catalog search, artist discography, and album tracklists.
# Obtain from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID="YOUR_SPOTIFY_CLIENT_ID"
SPOTIFY_CLIENT_SECRET="YOUR_SPOTIFY_CLIENT_SECRET"
SPOTIFY_MARKET="NL"

# Headliner API (Animated Apple Music artwork & artist headers)
# Base URL for animated headers, album video motion, and artist logos.
HEADLINER_API_BASE_URL="https://headliner.nandoothjuuh.me"

# LRCLIB Client Identification (HTTP User-Agent Header)
# Optional custom client identifier for LRCLIB requests.
LRCLIB_APP_ID="LRCGlass/1.0 (https://ais-dev-f4voj2jzp674brcho2lehu-650954615249.europe-west3.run.app)"

# Genius API Access Token (Optional)
# For authorized song and artist discovery lookup.
GENIUS_ACCESS_TOKEN=""

# Server Port
PORT=3000
