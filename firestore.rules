rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.:]+$');
    }

    // --- Contributions Collection ---
    match /contributions/{contributionId} {
      allow read: if true;
      allow create: if isValidId(contributionId) &&
        request.resource.data.trackTitle is string &&
        request.resource.data.trackTitle.size() <= 200 &&
        request.resource.data.artistName is string &&
        request.resource.data.artistName.size() <= 200 &&
        request.resource.data.content is string &&
        request.resource.data.content.size() <= 50000 &&
        (request.resource.data.format in ['plain', 'lrc', 'enhanced-lrc', 'ttml']);

      allow update: if isValidId(contributionId) &&
        (
          // Voting action
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes']) ||
          // Author editing content
          (isSignedIn() && resource.data.authorUid == request.auth.uid &&
            request.resource.data.content is string &&
            request.resource.data.content.size() <= 50000)
        );

      allow delete: if isSignedIn() && resource.data.authorUid == request.auth.uid;
    }

    // --- Track Audios Collection (User Added Audio for Playback) ---
    match /track_audios/{audioId} {
      allow read: if true;
      allow create: if isValidId(audioId) &&
        request.resource.data.trackCode is string &&
        request.resource.data.trackCode.size() <= 128 &&
        request.resource.data.audioUrl is string &&
        request.resource.data.audioUrl.size() <= 2000;

      allow update: if isValidId(audioId) &&
        request.resource.data.audioUrl is string &&
        request.resource.data.audioUrl.size() <= 2000;

      allow delete: if isSignedIn() && (resource.data.authorUid == request.auth.uid || !('authorUid' in resource.data));
    }

    // --- Image Feedback Collection ---
    match /image_feedback/{feedbackId} {
      allow read: if true;
      allow create, update: if feedbackId is string && feedbackId.size() <= 256 &&
        request.resource.data.artistName is string &&
        request.resource.data.artistName.size() <= 200 &&
        request.resource.data.imageUrl is string &&
        request.resource.data.imageUrl.size() <= 1000;
      allow delete: if false;
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId) &&
        request.resource.data.uid == userId;
      allow delete: if isOwner(userId);
    }
  }
}
